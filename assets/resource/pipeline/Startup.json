            "[JumpBack]LoginUpdateConfirm",
            "[JumpBack]BilibiliLoginClick",
            "[JumpBack]LoginClickEnter",
            "[JumpBack]LoginStartGameButton",
            "[JumpBack]ClaimExpressSupplyPass",
            "[JumpBack]CloseCommonPopup",
            "[JumpBack]ProbeOpenPhoneMenu"
        ]
    },
