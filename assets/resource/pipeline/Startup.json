{
    "StartUp": {
        "desc": "启动星穹铁道并进入大世界入口",
        "next": [
            "InPhoneMenuDetected",
            "StartUpApp"
        ]
    },
    "StartUpApp": {
        "desc": "调用 StartApp 启动崩坏：星穹铁道（默认官服，可由选项或 B 服资源覆盖）",
